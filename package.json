{
  "name": "voice_book",
  "version": "1.0.0",
  "description": "Reference-inspired 3D book and curved page-turn scaffold",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "narration:plan": "node --env-file-if-exists=.env.local skills/children-storybook/scripts/prepare_narration.mjs --plan",
    "narration:generate": "node --env-file-if-exists=.env.local skills/children-storybook/scripts/prepare_narration.mjs --generate",
    "narrate": "node --env-file-if-exists=.env.local skills/children-storybook/scripts/narrate.mjs",
    "narration:fixture": "node skills/children-storybook/scripts/prepare_narration.mjs --fixture",
    "video:export": "node --env-file-if-exists=.env.local skills/children-storybook/scripts/export_video.mjs",
    "test:media": "node --test tests/media.test.mjs",
    "test:narration": "node --test tests/tts-endpoint.test.mjs",
    "test:scripts": "node --test tests/script-entry.test.mjs",
    "test:skill": "python3 skills/children-storybook/scripts/test_build_book.py && python3 skills/children-storybook/scripts/test_gen_prompts.py && python3 skills/children-storybook/scripts/test_gen_art.py && python3 skills/children-storybook/scripts/test_example_story.py && python3 skills/children-storybook/scripts/test_preview_art.py && node --test tests/script-entry.test.mjs && node --test tests/publishing.test.mjs && node skills/children-storybook/renderer/build.mjs --check",
    "build:renderer": "node skills/children-storybook/renderer/build.mjs",
    "video:verify-fixture": "node skills/children-storybook/scripts/verify_fixture_audio.mjs",
    "publish:bundle": "node skills/children-storybook/scripts/publish_bundle.mjs",
    "test:publishing": "node --test tests/publishing.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  }
}
